[gd_resource type="Resource" script_class="Location" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/systems/location.gd" id="1_location"]
[ext_resource type="Resource" path="res://resources/enemies/skeleton.tres" id="2_skeleton"]
[ext_resource type="Resource" path="res://resources/enemies/cultist.tres" id="3_cultist"]
[ext_resource type="Resource" path="res://resources/enemies/demon.tres" id="4_demon"]
[ext_resource type="Resource" path="res://resources/enemies/fallen_king.tres" id="5_king"]

[resource]
script = ExtResource("1_location")
id = &"dark_castle"
display_name = "Castelul Întunecat"
description = "Aici apar cei care trag de la distanță. Cercul de sub picioare e singurul avertisment pe care-l primești."
rooms = 10
floor_color = Color(0.1, 0.11, 0.18, 1)
grid_color = Color(0.16, 0.18, 0.28, 1)
border_color = Color(0.44, 0.6, 0.95, 1)
enemy_types = Array[Resource]([ExtResource("2_skeleton"), ExtResource("3_cultist"), ExtResource("4_demon")])
boss = ExtResource("5_king")
base_enemy_count = 5
enemies_per_room = 1.1
max_enemy_count = 12
