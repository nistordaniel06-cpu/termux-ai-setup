[resource]
script = ExtResource("1_location")
id = &"shadow_realm"
display_name = "Tărâmul Umbrelor"
description = "Tot ce e mai rău, deodată. Dacă ajungi aici fără o evoluție, n-ai ce căuta înăuntru."
rooms = 14
floor_color = Color(0.13, 0.08, 0.19, 1)
grid_color = Color(0.21, 0.13, 0.3, 1)
border_color = Color(0.73, 0.42, 0.98, 1)
enemy_types = Array[Resource]([ExtResource("2_cultist"), ExtResource("3_demon"), ExtResource("4_knight")])
boss = ExtResource("5_king")
