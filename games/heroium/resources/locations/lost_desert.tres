[gd_resource type="Resource" script_class="Location" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/systems/location.gd" id="1_location"]
[ext_resource type="Resource" path="res://resources/enemies/necromancer.tres" id="2_boss"]
[ext_resource type="Resource" path="res://resources/enemies/bat.tres" id="3_e"]
[ext_resource type="Resource" path="res://resources/enemies/skeleton_archer.tres" id="4_e"]
[ext_resource type="Resource" path="res://resources/enemies/skeleton_mage.tres" id="5_e"]
[ext_resource type="Resource" path="res://resources/enemies/undead_knight.tres" id="6_e"]

[resource]
script = ExtResource("1_location")
id = &"lost_desert"
display_name = "Deșertul Morților"
description = "Cavaleri cu armură groasă și magi care lovesc tare. Aici daunele mici nu mai ajung - ai nevoie de o evoluție."
rooms = 12
floor_color = Color(0.19, 0.14, 0.09, 1)
grid_color = Color(0.28, 0.21, 0.13, 1)
border_color = Color(0.95, 0.67, 0.29, 1)
enemy_types = Array[Resource]([ ExtResource("3_e"), ExtResource("4_e"), ExtResource("5_e"), ExtResource("6_e"), ])
boss = ExtResource("2_boss")
base_enemy_count = 4
enemies_per_room = 1.1
max_enemy_count = 12
