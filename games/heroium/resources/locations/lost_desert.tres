[gd_resource type="Resource" script_class="Location" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/systems/location.gd" id="1_location"]
[ext_resource type="Resource" path="res://resources/enemies/bat.tres" id="2_bat"]
[ext_resource type="Resource" path="res://resources/enemies/cultist.tres" id="3_cultist"]
[ext_resource type="Resource" path="res://resources/enemies/dread_knight.tres" id="4_knight"]
[ext_resource type="Resource" path="res://resources/enemies/bone_colossus.tres" id="5_colossus"]

[resource]
script = ExtResource("1_location")
id = &"lost_desert"
display_name = "Deșertul Pierdut"
description = "Cavaleri blestemați, cu armură groasă. Aici daunele mici nu mai ajung - ai nevoie de o evoluție."
rooms = 12
floor_color = Color(0.19, 0.14, 0.09, 1)
grid_color = Color(0.28, 0.21, 0.13, 1)
border_color = Color(0.95, 0.67, 0.29, 1)
enemy_types = Array[Resource]([ExtResource("2_bat"), ExtResource("3_cultist"), ExtResource("4_knight")])
boss = ExtResource("5_colossus")
base_enemy_count = 5
enemies_per_room = 1.15
max_enemy_count = 13
