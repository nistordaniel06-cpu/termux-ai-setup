; Heroium - action roguelike in stil Archero
; Configuratia proiectului Godot 4

config_version=5

[application]

config/name="Heroium"
config/description="Luptă. Adună. Evoluează. Devino legendar."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

; Ordinea conteaza: autoloadurile se initializeaza in ordinea de aici, iar
; GameState incarca la randul lui toate resursele de abilitati in _ready(). Un
; efect ca EffectLightningChain foloseste Fx.burst() chiar in corpul scriptului,
; deci daca Fx n-a fost inca inregistrat ca identificator global, compilarea lui
; pica o singura data - si, fiindca resursa incarcata de GameState ramane in
; cache, scriptul stricat ramane stricat tot procesul, nu doar acel cadru. Fx
; trebuie sa fie inaintea lui GameState.
Loc="*res://scripts/systems/loc.gd"
Fx="*res://scripts/systems/fx.gd"
Pool="*res://scripts/systems/pool.gd"
GameState="*res://scripts/systems/game_state.gd"

[display]

; Rezolutie verticala de telefon; "expand" acopera si ecranele mai inalte
window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick/plugin.cfg")

[input_devices]

; Butoanele (Control) reactioneaza la evenimente de MOUSE. Fara emularea de mai
; jos, o atingere cu degetul nu devine niciodata apasare, si atunci niciun buton
; din joc nu poate fi folosit pe telefon - meniu, carti de nivel, pauza, tot.
;
; Addonul de joystick cere in consola exact pe dos ("should be set to False"),
; dar acela e un printerr, nu o cerinta: joystick-ul citeste singur
; InputEventScreenTouch in `_input`, care ii ajunge oricum. Urmand acel
; avertisment am livrat un joc in care nu se putea apasa nimic.
pointing/emulate_mouse_from_touch=true
; Mouse-ul trece drept atingere, ca joystick-ul sa mearga si in browser pe desktop.
pointing/emulate_touch_from_mouse=true

[input]

move_left={
"deadzone": 0.2,
