[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="hero"
2d_physics/layer_3="enemy"
2d_physics/layer_4="hero_projectile"
2d_physics/layer_5="enemy_projectile"
2d_physics/layer_6="pickup"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
; "gl_compatibility" (nu "mobile") - e singurul renderer pe care Godot 4 il
; poate exporta pentru Web (WebGL2), si merge la fel de bine pe Android.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Ce se vede dincolo de peretii camerei. Grina implicit se citea ca un ecran
; blocat; negrul-violet arata ca marginea e intentionata.
environment/defaults/default_clear_color=Color(0.043, 0.031, 0.078, 1)
