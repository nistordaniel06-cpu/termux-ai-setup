generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  SALON_OWNER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ReferralStatus {
  PENDING
  REWARDED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          UserRole
  referralCode  String   @unique
  referredById  String?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id])
  referredUsers User[]   @relation("Referrals")
  notificationsEnabled Boolean @default(true)
  createdAt     DateTime @default(now())

  businesses     Business[]     @relation("BusinessOwner")
  professional   Professional?
  bookings       Booking[]      @relation("CustomerBookings")
  customerLinks  Customer[]
  reviews        Review[]
  favorites      Favorite[]
  referralsFrom  Referral[]     @relation("ReferralFrom")
  referralsTo    Referral[]     @relation("ReferralTo")
  rewards        Reward[]
  notifications  Notification[]
}

model Business {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("BusinessOwner", fields: [ownerId], references: [id])
  name        String
  slug        String   @unique
  description String?
  address     String?
  city        String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  // Growth engine (Phase 3): the business opts in and bounds its own
  // empty-slot discounts — never applied without both limits configured.
  minDiscountPercent Int?
  maxDiscountPercent Int?
  // Loyalty (Phase 3): every N visits earns a reward. Null = feature off.
  loyaltyVisitsRequired Int?

  professionals   Professional[]
  services        Service[]
  customers       Customer[]
  offers          Offer[]
  analyticsEvents AnalyticsEvent[]
  bookings        Booking[]
  favoritedBy     Favorite[]
  rewards         Reward[]
}

model Professional {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  displayName String
  bio         String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  schedules     Schedule[]
  availability  Availability[]
  bookings      Booking[]

  @@index([businessId])
}

model Service {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id])
  name             String
  durationMinutes  Int
  priceCents       Int
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  bookings Booking[]

  @@index([businessId])
}

// Weekly recurring working hours for a professional.
model Schedule {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  dayOfWeek      Int // 0 = Sunday .. 6 = Saturday
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"

  @@unique([professionalId, dayOfWeek])
}

// One-off overrides on top of the weekly Schedule: extra hours or time off.
model Availability {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  date           DateTime // calendar day, time components ignored
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  isBlocked      Boolean      @default(false)

  @@index([professionalId, date])
}

model Booking {
  id             String        @id @default(uuid())
  customerId     String
  customer       User          @relation("CustomerBookings", fields: [customerId], references: [id])
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id])
  professionalId String
  professional   Professional  @relation(fields: [professionalId], references: [id])
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(CONFIRMED)
  createdAt      DateTime      @default(now())

  review Review?

  // Double-booking is prevented at the application level (see booking.service:
  // assertSlotIsBookable runs inside a SERIALIZABLE transaction), not by a DB
  // unique constraint here — a plain (professionalId, startTime) uniqueness
  // rule would wrongly block rebooking a slot freed by a CANCELLED booking.
  @@index([professionalId, startTime])
  @@index([businessId])
  @@index([customerId])
}

model Customer {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id])
  firstVisitAt DateTime?
  lastVisitAt  DateTime?
  visitCount   Int       @default(0)

  @@unique([userId, businessId])
}

// Phase 2
model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

// Phase 2
model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

// Phase 3
model Offer {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime @default(now())

  @@index([businessId, endsAt])
}

// Phase 3
model Referral {
  id             String         @id @default(uuid())
  referrerUserId String
  referrer       User           @relation("ReferralFrom", fields: [referrerUserId], references: [id])
  referredUserId String
  referred       User           @relation("ReferralTo", fields: [referredUserId], references: [id])
  status         ReferralStatus @default(PENDING)
  rewardedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@unique([referrerUserId, referredUserId])
}

// Phase 3
model Reward {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  // Set for business-scoped rewards (loyalty); null for platform-wide ones (referral).
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  type       String
  amount     Int
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Phase 3
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// Phase 1 writes events; Phase 4 builds reporting on top of them.
model AnalyticsEvent {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  type       String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([businessId, type])
}
